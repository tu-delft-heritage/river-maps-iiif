{
  "name": "river-maps-iiif",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "sync": "node scripts/sync.ts",
    "sync:na": "python3 scripts/sync-nationaal-archief.py",
    "build": "node scripts/build.ts",
    "check": "tsc --noEmit",
    "test": "node --test scripts/*.test.ts && python3 -m unittest discover -s scripts -p '*_test.py'",
    "validate": "pnpm check && pnpm test && pnpm build && pnpm check:allmaps",
    "georeference:hydrate": ".venv/bin/python scripts/georeferencing/georeference.py hydrate",
    "georeference:pilot": ".venv/bin/python scripts/georeferencing/georeference.py pilot --offline && node scripts/georeferencing/georeference-attach.ts && node scripts/georeferencing/georeference-export.ts && .venv/bin/python scripts/georeferencing/georeference/report.py",
    "georeference:test": "node --test scripts/georeferencing/*.test.ts && .venv/bin/python -m unittest discover -s tests/georeference -p \"test_*.py\"",
    "georeference:validate": "pnpm georeference:test && pnpm validate",
    "georeference:batch": ".venv/bin/python scripts/georeferencing/georeference_batch.py measure --batch batch-01 --offline && node scripts/georeferencing/georeference-batch-export.ts batch-01",
    "georeference:dashboard": "node scripts/georeferencing/georeference-progress.ts",
    "georeference:release": "node scripts/georeferencing/georeference-release.ts && pnpm build",
    "check:allmaps": "node scripts/check-allmaps.ts"
  },
  "dependencies": {
    "@allmaps/annotation": "1.0.0-beta.38",
    "@allmaps/attach": "1.0.0-beta.51",
    "@allmaps/iiif-parser": "1.0.0-beta.49",
    "@allmaps/transform": "1.0.0-beta.53",
    "@iiif/helpers": "4.0.5",
    "@iiif/parser": "^4.0.7",
    "htm": "^3.1.1",
    "preact": "^11.2.0",
    "preact-render-to-string": "^6.8.3"
  },
  "devDependencies": {
    "@iiif/presentation-3": "2.2.4",
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2"
  }
}
