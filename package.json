{
  "name": "river-maps-iiif",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "sync": "node scripts/sync.ts",
    "sync:na": "python3 scripts/sync-nationaal-archief.py",
    "build": "node scripts/build.ts",
    "check": "tsc --noEmit",
    "test": "node --test scripts/*.test.ts && python3 -m unittest discover -s scripts -p '*_test.py'",
    "validate": "pnpm check && pnpm test && pnpm build"
  },
  "dependencies": {
    "@iiif/helpers": "4.0.5",
    "@iiif/parser": "^4.0.7",
    "htm": "^3.1.1",
    "preact": "^11.2.0",
    "preact-render-to-string": "^6.8.3",
    "@allmaps/annotation": "1.0.0-beta.38",
    "@allmaps/transform": "1.0.0-beta.53"
  },
  "devDependencies": {
    "@iiif/presentation-3": "2.2.4",
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2"
  }
}
